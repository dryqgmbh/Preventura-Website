<div class="product-card">
  <a href="{{ product.url }}" class="product-card__link">
    <div class="product-card__media">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', class: 'product-card__image', sizes: '(min-width: 990px) 25vw, 50vw', widths: '200,300,400,600' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__image placeholder' }}
      {%- endif -%}
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__badge">{{ 'products.product.on_sale' | t }}</span>
      {%- elsif product.available == false -%}
        <span class="product-card__badge product-card__badge--sold">{{ 'products.product.sold_out' | t }}</span>
      {%- endif -%}
    </div>
    <div class="product-card__info">
      <h3 class="product-card__title">{{ product.title }}</h3>
      {%- if product.description != blank -%}
        <p class="product-card__excerpt">{{ product.description | strip_html | truncatewords: 14 }}</p>
      {%- endif -%}
      {% render 'price', product: product %}
    </div>
  </a>
</div>

<div class="section newsletter-section" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }};">
  <div class="page-width page-width--narrow newsletter-section__inner">
    {%- if section.settings.heading != blank -%}<h2 class="section__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="newsletter-section__text">{{ section.settings.text }}</p>{%- endif -%}
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form newsletter-form--large">
        <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required aria-label="E-Mail">
        <button type="submit" class="btn btn--primary btn--large">{{ 'general.newsletter.button' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'general.newsletter.success' | t }}</p>
      {%- endif -%}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Bleiben Sie gesund informiert" },
    { "type": "text", "id": "text", "label": "Text", "default": "Erhalten Sie Gesundheitstipps, Studien und exklusive Angebote direkt in Ihr Postfach." },
    { "type": "color", "id": "background", "label": "Hintergrundfarbe", "default": "#0b6b5f" },
    { "type": "color", "id": "text_color", "label": "Textfarbe", "default": "#ffffff" }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}

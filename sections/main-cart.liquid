<div class="section cart-page">
  <div class="page-width page-width--narrow">
    <h1 class="cart-page__title">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      {% form 'cart', cart, class: 'cart-form' %}
        <ul class="cart-items">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a href="{{ item.url }}" class="cart-item__image-link">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'cart-item__image' }}
                {%- endif -%}
              </a>
              <div class="cart-item__details">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="cart-item__price">{{ item.final_price | money }}</p>
              </div>
              <div class="cart-item__quantity">
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="quantity-selector__input" aria-label="{{ 'cart.quantity' | t }}">
              </div>
              <div class="cart-item__total">{{ item.final_line_price | money }}</div>
              <a href="{{ item.url_to_remove }}" class="cart-item__remove" aria-label="{{ 'cart.remove' | t }}">{% render 'icon', name: 'trash' %}</a>
            </li>
          {%- endfor -%}
        </ul>

        <div class="cart-footer">
          <div class="cart-footer__totals">
            <div class="cart-footer__subtotal">
              <span>{{ 'cart.subtotal' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <p class="cart-footer__note">{{ 'cart.shipping_note' | t }}</p>
          </div>
          <div class="cart-footer__actions">
            <button type="submit" name="update" class="btn btn--ghost">{{ 'cart.update' | t }}</button>
            <button type="submit" name="checkout" class="btn btn--primary btn--large">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      {% endform %}
    {%- else -%}
      <div class="cart-empty">
        <p>{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--large">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Warenkorb",
  "settings": []
}
{% endschema %}

<div class="section faq" style="background:{{ section.settings.background }};">
  <div class="page-width page-width--narrow">
    <div class="section__header section__header--center">
      {%- if section.settings.eyebrow != blank -%}<p class="section__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary class="faq__question">
            <span>{{ block.settings.question }}</span>
            {% render 'icon', name: 'plus' %}
          </summary>
          <div class="faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleiner Text oben", "default": "Häufige Fragen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Alles, was Sie wissen müssen" },
    { "type": "color", "id": "background", "label": "Hintergrundfarbe", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Frage & Antwort",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "Wie funktioniert die Probenentnahme?" },
        { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Die Entnahme erfolgt einfach und schmerzarm zuhause. Eine bebilderte Anleitung liegt jedem Kit bei.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa" },
        { "type": "qa", "settings": { "question": "Wie schnell erhalte ich meine Ergebnisse?", "answer": "<p>In der Regel innerhalb von 3 Tagen nach Eingang Ihrer Probe im Labor.</p>" } },
        { "type": "qa", "settings": { "question": "Sind meine Daten sicher?", "answer": "<p>Ja. Wir verarbeiten Ihre Daten DSGVO-konform und verschlüsselt.</p>" } },
        { "type": "qa", "settings": { "question": "Kann ich mein Abo jederzeit kündigen?", "answer": "<p>Ja, Sie können jederzeit flexibel pausieren oder kündigen.</p>" } }
      ]
    }
  ]
}
{% endschema %}

<div class="section how-it-works" id="how" style="background:{{ section.settings.background }};">
  <div class="page-width">
    <div class="section__header section__header--center">
      {%- if section.settings.eyebrow != blank -%}<p class="section__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step" {{ block.shopify_attributes }}>
          <div class="step__number">{{ forloop.index }}</div>
          {%- if block.settings.image != blank -%}
            <div class="step__media">{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'step__image' }}</div>
          {%- endif -%}
          <h3 class="step__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="step__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_text != blank -%}
      <div class="section__footer section__footer--center">
        <a href="{{ section.settings.button_link }}" class="btn btn--primary btn--large">{{ section.settings.button_text }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "So funktioniert's",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleiner Text oben", "default": "Einfach & sicher" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "So funktioniert's" },
    { "type": "text", "id": "subheading", "label": "Untertitel", "default": "In drei einfachen Schritten zu mehr Klarheit über Ihre Gesundheit." },
    { "type": "color", "id": "background", "label": "Hintergrundfarbe", "default": "#ffffff" },
    { "type": "text", "id": "button_text", "label": "Button-Text", "default": "Test bestellen" },
    { "type": "url", "id": "button_link", "label": "Button-Link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Test bestellen" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Wählen Sie den passenden Test und erhalten Sie Ihr Kit bequem nach Hause." }
      ]
    }
  ],
  "presets": [
    {
      "name": "So funktioniert's",
      "blocks": [
        { "type": "step", "settings": { "title": "1. Test bestellen", "text": "Wählen Sie Ihren Gesundheitstest – diskret nach Hause geliefert." } },
        { "type": "step", "settings": { "title": "2. Probe entnehmen", "text": "Einfache Entnahme zuhause in wenigen Minuten und kostenlos zurücksenden." } },
        { "type": "step", "settings": { "title": "3. Ergebnisse erhalten", "text": "Verständliche Auswertung in Ihrem Dashboard – inkl. Empfehlungen." } }
      ]
    }
  ]
}
{% endschema %}

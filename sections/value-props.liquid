<div class="section value-props" style="background:{{ section.settings.background }};">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section__header section__header--center">
        <h2 class="section__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="value-props__grid">
      {%- for block in section.blocks -%}
        <div class="value-prop" {{ block.shopify_attributes }}>
          <div class="value-prop__icon">{% render 'icon', name: block.settings.icon %}</div>
          <h3 class="value-prop__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="value-prop__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vorteile",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Warum Preventura?" },
    { "type": "color", "id": "background", "label": "Hintergrundfarbe", "default": "#eef6f3" }
  ],
  "blocks": [
    {
      "type": "prop",
      "name": "Vorteil",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Schild" },
            { "value": "heart", "label": "Herz" },
            { "value": "lab", "label": "Labor" },
            { "value": "clock", "label": "Uhr" },
            { "value": "leaf", "label": "Blatt" },
            { "value": "truck", "label": "Versand" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "title", "label": "Titel", "default": "Vorteil" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vorteile",
      "blocks": [
        { "type": "prop", "settings": { "icon": "lab", "title": "Zertifizierte Labore", "text": "Analysen nach höchsten medizinischen Standards." } },
        { "type": "prop", "settings": { "icon": "clock", "title": "Schnelle Ergebnisse", "text": "Verständliche Auswertung in wenigen Tagen." } },
        { "type": "prop", "settings": { "icon": "shield", "title": "Datenschutz", "text": "Ihre Daten sind sicher und DSGVO-konform geschützt." } },
        { "type": "prop", "settings": { "icon": "truck", "title": "Kostenloser Versand", "text": "Diskrete Lieferung und Rücksendung inklusive." } }
      ]
    }
  ]
}
{% endschema %}

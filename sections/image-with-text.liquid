<div class="section image-with-text image-with-text--{{ section.settings.layout }}" style="background:{{ section.settings.background }};">
  <div class="page-width image-with-text__inner">
    {%- if section.settings.image != blank -%}
      <div class="image-with-text__media">
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'image-with-text__image', sizes: '(min-width: 990px) 50vw, 100vw', widths: '400,600,800,1000' }}
      </div>
    {%- endif -%}
    <div class="image-with-text__content">
      {%- if section.settings.eyebrow != blank -%}<p class="section__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_text }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bild mit Text",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Bildposition",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "text", "id": "eyebrow", "label": "Kleiner Text oben", "default": "Unsere Mission" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Prävention für alle zugänglich machen" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Wir glauben, dass jeder Mensch ein Recht darauf hat, den eigenen Körper zu verstehen. Mit Preventura wird Vorsorge einfach, bezahlbar und alltagstauglich.</p>" },
    { "type": "text", "id": "button_text", "label": "Button-Text", "default": "Mehr über uns" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "color", "id": "background", "label": "Hintergrundfarbe", "default": "#ffffff" }
  ],
  "presets": [
    { "name": "Bild mit Text" }
  ]
}
{% endschema %}

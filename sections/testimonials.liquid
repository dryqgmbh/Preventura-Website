<div class="section testimonials" style="background:{{ section.settings.background }};">
  <div class="page-width">
    <div class="section__header section__header--center">
      {%- if section.settings.eyebrow != blank -%}<p class="section__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        <figure class="testimonial" {{ block.shopify_attributes }}>
          <div class="testimonial__stars">
            {%- for i in (1..block.settings.rating) -%}{% render 'icon', name: 'star' %}{%- endfor -%}
          </div>
          <blockquote class="testimonial__quote">{{ block.settings.quote }}</blockquote>
          <figcaption class="testimonial__author">
            {%- if block.settings.author_image != blank -%}
              {{ block.settings.author_image | image_url: width: 96 | image_tag: loading: 'lazy', class: 'testimonial__avatar' }}
            {%- endif -%}
            <span>{{ block.settings.author }}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleiner Text oben", "default": "Das sagen unsere Kund:innen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Tausende vertrauen auf Preventura" },
    { "type": "color", "id": "background", "label": "Hintergrundfarbe", "default": "#eef6f3" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Bewertung",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Sterne", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Zitat", "default": "Endlich verstehe ich meine Werte. Der Test war super einfach und das Ergebnis verständlich erklärt." },
        { "type": "text", "id": "author", "label": "Name", "default": "Anna M." },
        { "type": "image_picker", "id": "author_image", "label": "Foto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial", "settings": { "quote": "Schnell, diskret und unkompliziert. Ich tracke jetzt regelmäßig meine Gesundheit.", "author": "Thomas K." } },
        { "type": "testimonial", "settings": { "quote": "Die Beratung war top und ich fühle mich endlich gut informiert.", "author": "Lisa R." } }
      ]
    }
  ]
}
{% endschema %}

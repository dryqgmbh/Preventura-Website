{%- if section.settings.show_announcement and section.settings.text != blank -%}
  <div class="announcement-bar" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }};">
    <div class="page-width announcement-bar__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement-bar__link">{{ section.settings.text }}</a>
      {%- else -%}
        <span>{{ section.settings.text }}</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ankündigungsleiste",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Leiste anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Kostenloser Versand ab 50 €"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Hintergrundfarbe",
      "default": "#0b6b5f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}

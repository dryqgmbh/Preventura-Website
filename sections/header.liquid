<header class="site-header{% if section.settings.sticky_header %} site-header--sticky{% endif %}" data-header>
  <div class="page-width site-header__inner">
    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 300 | image_tag: loading: 'eager', alt: shop.name, class: 'site-header__logo-img' }}
      {%- else -%}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="site-nav" aria-label="{{ 'general.navigation' | t }}">
      <ul class="site-nav__list">
        {%- for link in section.settings.menu.links -%}
          <li class="site-nav__item{% if link.links != blank %} site-nav__item--has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="site-nav__link{% if link.active %} site-nav__link--active{% endif %}">
              {{ link.title }}
            </a>
            {%- if link.links != blank -%}
              <ul class="site-nav__dropdown">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}" class="site-nav__dropdown-link">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="{{ routes.search_url }}" class="header-icon" aria-label="{{ 'general.search.search' | t }}">
        {% render 'icon', name: 'search' %}
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header-icon" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="header-icon header-icon--cart" aria-label="{{ 'general.cart.title' | t }}" data-cart-icon>
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
      {%- if section.settings.show_cta and section.settings.cta_link != blank -%}
        <a href="{{ section.settings.cta_link }}" class="btn btn--primary btn--small site-header__cta">{{ section.settings.cta_text }}</a>
      {%- endif -%}
      <button class="header-menu-toggle" aria-label="{{ 'general.navigation' | t }}" data-menu-toggle aria-expanded="false">
        {% render 'icon', name: 'menu' %}
      </button>
    </div>
  </div>

  <div class="mobile-nav" data-mobile-nav hidden>
    <ul class="mobile-nav__list">
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}" class="mobile-nav__link">{{ link.title }}</a>
          {%- if link.links != blank -%}
            <ul class="mobile-nav__sublist">
              {%- for child in link.links -%}
                <li><a href="{{ child.url }}" class="mobile-nav__sublink">{{ child.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menü",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Header beim Scrollen fixieren",
      "default": true
    },
    {
      "type": "header",
      "content": "Call-to-Action Button"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Button anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button-Text",
      "default": "Jetzt starten"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button-Link"
    }
  ]
}
{% endschema %}
